---
import BaseLayout from "@/base/BaseLayout.astro";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import {
	type LexicalContent,
	renderLexicalToHtml,
} from "@/lib/lexical-renderer";
import { siteMeta } from "@/lib/siteData";
import { type BlogPost, getPayloadClient } from "@/payload";

const { slug } = Astro.params;

const { env } = Astro.locals.runtime;
const r2BaseUrl = import.meta.env.PUBLIC_R2_URL;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

let post: BlogPost | null = null;
let error: string | null = null;

if (!slug) {
	return Astro.redirect("/post");
}

try {
	post = await payload.getBlogPostBySlug(slug);

	if (!post) {
		return Astro.redirect("/404");
	}
} catch (e) {
	console.error("Failed to fetch blog post:", e);
	error = e instanceof Error ? e.message : "Failed to fetch blog post";
}

const pageTitle = post
	? `${post.title} | Blog | ${siteMeta.title}`
	: `Blog | ${siteMeta.title}`;

const contentHtml = post?.content
	? renderLexicalToHtml(post.content as unknown as LexicalContent, r2BaseUrl)
	: "";

const displayDate = post?.publishDate || post?.publishedAt || post?.createdAt;
---

<BaseLayout title={pageTitle}>
	<article class="max-w-4xl mx-auto px-4 py-8">
		<Breadcrumb class="mb-6">
			<BreadcrumbList>
				<BreadcrumbItem>
					<BreadcrumbLink href="/">Home</BreadcrumbLink>
				</BreadcrumbItem>
				<BreadcrumbSeparator />
				<BreadcrumbItem>
					<BreadcrumbLink href="/post">Blog</BreadcrumbLink>
				</BreadcrumbItem>
				<BreadcrumbSeparator />
				<BreadcrumbItem>
					<BreadcrumbPage>{post?.title}</BreadcrumbPage>
				</BreadcrumbItem>
			</BreadcrumbList>
		</Breadcrumb>

		{error && (
			<div class="bg-error/10 border border-error text-error-foreground p-4 rounded-lg mb-6">
				<p>Error loading post: {error}</p>
			</div>
		)}

		{post && (
			<>
				<header class="mb-8 text-center">
					<h1 class="mb-4">{post.title}</h1>
					{post.description && (
						<p class="text-lg text-muted-foreground mb-4">{post.description}</p>
					)}
					{displayDate && (
						<p class="text-sm text-muted-foreground">
							Published on {new Date(displayDate).toLocaleDateString("en-US", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</p>
					)}
				</header>

				<div class="prose prose-lg max-w-none dark:prose-invert" set:html={contentHtml} />
			</>
		)}
	</article>
</BaseLayout>
