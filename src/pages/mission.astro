---
import BaseLayout from "@/base/BaseLayout.astro";

const title = "Mission | SFTI Radio";
---

<BaseLayout title={title}>
  <div class="max-w-4xl mx-auto space-y-4">
    <h1>Mission</h1>
    <p>SFTI Radio exists to support the mission of The Society for the Innocents, including the Saint Anne House initiative. Our local streams are designed to serve communities with uplifting Christian music and local content. Please visit our web page at <a href="https://www.thesocietyfortheinnocents.org/donate/?utm_source=sfti-radio_net&utm_medium=web&utm_campaign=website-link" target="_blank" rel="noopener nofollow">www.thesocietyfortheinnocents.org</a> for more information.</p>
  </div>
</BaseLayout>