---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/base/BaseLayout.astro";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import {
	Card,
	CardContent,
	CardDescription,
	CardHeader,
	CardTitle,
} from "@/components/starwind/card";
import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "@/components/starwind/item";
import { getMediaUrl } from "@/lib/cms-r2-media";
import { type BlogPost, getPayloadClient, type LocalEvent, type MarketArea, type News, type Sports } from "@/payload";

const { env } = Astro.locals.runtime;
const r2BaseUrl = import.meta.env.PUBLIC_R2_URL;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

// Fetch latest news, sports, blog posts, market areas, and upcoming events
let latestNews: News[] = [];
let latestSports: Sports[] = [];
let latestBlogPosts: BlogPost[] = [];
let marketAreas: MarketArea[] = [];
let upcomingEvents: LocalEvent[] = [];

try {
	const [newsResult, sportsResult, blogResult, marketAreasResult, eventsResult] = await Promise.all([
		payload.getNews({ limit: 3, sort: "-publishDate", depth: 1 }),
		payload.getSports({ limit: 3, sort: "-publishDate", depth: 1 }),
		payload.getBlogPosts({ limit: 3, sort: "-publishDate" }),
		payload.getMarketAreas({ limit: 50, sort: "name" }),
		payload.getUpcomingLocalEvents({ limit: 3, depth: 1 }),
	]);
	latestNews = newsResult.docs;
	latestSports = sportsResult.docs;
	latestBlogPosts = blogResult.docs;
	marketAreas = marketAreasResult.docs;
	upcomingEvents = eventsResult.docs;
} catch (e) {
	console.error("Failed to fetch content:", e);
}

// Helper to get image URL from media object
function getImageFromMedia(media: unknown): string | null {
	if (!media || typeof media !== "object") return null;
	const mediaObj = media as { filename?: string };
	if (!mediaObj.filename) return null;
	return getMediaUrl(mediaObj as Parameters<typeof getMediaUrl>[0], r2BaseUrl);
}

// Helper to format date
function formatDate(dateString: string | undefined): string {
	if (!dateString) return "";
	return new Date(dateString).toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

// Helper to get market area slug from a news or sports item
function getMarketAreaSlug(marketArea: unknown): string | null {
	if (!marketArea) return null;
	if (typeof marketArea === "string") return null; // Just an ID, not populated
	if (typeof marketArea === "object" && "slug" in marketArea) {
		return (marketArea as { slug: string }).slug;
	}
	return null;
}

// Helper to get market area name from a news or sports item
function getMarketAreaName(marketArea: unknown): string | null {
	if (!marketArea) return null;
	if (typeof marketArea === "string") return null; // Just an ID, not populated
	if (typeof marketArea === "object" && "name" in marketArea) {
		return (marketArea as { name: string }).name;
	}
	return null;
}

// Helper to format event date (shows day of week for upcoming events)
function formatEventDate(dateString: string | undefined): string {
	if (!dateString) return "";
	return new Date(dateString).toLocaleDateString("en-US", {
		weekday: "short",
		month: "short",
		day: "numeric",
	});
}
---

<BaseLayout>
	<div class="w-full mx-auto px-4 py-8">
		<h1 class="mb-8 text-3xl font-bold text-foreground text-center">Welcome to SFTI Radio</h1>
		
		<!-- CSS Grid Layout -->
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-6">
			<!-- Communities -->
			<Card class="md:col-span-1 lg:col-span-3">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<Icon name="lucide--building-2" class="size-8" />
						Communities
					</CardTitle>
					<CardDescription>Explore our communities</CardDescription>
				</CardHeader>
				<CardContent>
					{marketAreas.length > 0 ? (
						<ul class="flex flex-wrap gap-2">
							<li>
								<Badge variant="outline" href="/communities">
									<Icon name="lucide--building-2" />
									<span class="ml-1">View All Communities</span>
								</Badge>	
							</li>
							{marketAreas.map((area) => (
								<li>
									<Badge variant="outline" href={`/communities/${area.slug}`}>
										{area.name}
									</Badge>
								</li>
							))}
						</ul>
					) : (
						<p class="text-muted-foreground">No communities available.</p>
					)}
				</CardContent>
			</Card>

			<!-- Station Links -->
			<Card class="md:col-span-1 lg:col-span-3">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<Icon name="material-symbols--music-cast-rounded" class="size-8" />
						Station Links
					</CardTitle>
					<CardDescription>Web radio links can go here.</CardDescription>
				</CardHeader>
				<CardContent>
					<ul class="flex flex-wrap gap-2">
						<li>
							<Badge variant="success" href="#">
								Station Link 1
							</Badge>	
						</li>
						<li>
							<Badge variant="success" href="#">
								Station Link 2
							</Badge>	
						</li>
						<li>
							<Badge variant="success" href="#">
								Station Link 3
							</Badge>	
						</li>
						<li>
							<Badge variant="success" href="#">
								Station Link 4
							</Badge>	
						</li>
					</ul>
				</CardContent>
			</Card>

			<!-- Latest News Section -->
			<Card class="md:col-span-1 lg:col-span-3">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<Icon name="lucide--newspaper" class="size-8" />
						Latest News
					</CardTitle>
					<CardDescription>Stay updated with the latest news</CardDescription>
				</CardHeader>
				<CardContent>
					{latestNews.length > 0 ? (
						<ItemGroup>
							{latestNews.map((news) => {
							const imageUrl = getImageFromMedia(news.featuredImage);
							const marketAreaSlug = getMarketAreaSlug(news.marketArea);
							const marketAreaName = getMarketAreaName(news.marketArea);
							const newsUrl = marketAreaSlug ? `/communities/${marketAreaSlug}/news/${news.slug}` : `/news/${news.slug}`;
							return (
								<Item as="a" href={newsUrl}>
									{imageUrl && (
										<ItemMedia variant="image" class="size-[100px]">
											<Image src={imageUrl} alt={news.title} width={100} height={100} />
										</ItemMedia>
									)}
									<ItemContent>
										<ItemTitle>{news.title}</ItemTitle>
										<ItemDescription>{news.description}</ItemDescription>
										{marketAreaName && <ItemDescription class="text-xs italic text-muted-foreground">{marketAreaName}</ItemDescription>}
										<ItemDescription class="text-xs">{formatDate(news.publishDate)}</ItemDescription>
									</ItemContent>
								</Item>
								<ItemSeparator class="last:hidden" />
							);
						})}
						</ItemGroup>
					) : (
						<p class="text-muted-foreground">No news articles available.</p>
					)}
				</CardContent>
			</Card>

			<!-- Sports Section -->
			<Card class="md:col-span-1 lg:col-span-3">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<Icon name="cil--american-football" class="size-8" />
						Sports
					</CardTitle>
					<CardDescription>Local sports coverage</CardDescription>
				</CardHeader>
				<CardContent>
					{latestSports.length > 0 ? (
						<ItemGroup>
							{latestSports.map((sport) => {
							const imageUrl = getImageFromMedia(sport.featuredImage);
							const marketAreaSlug = getMarketAreaSlug(sport.marketArea);
							const marketAreaName = getMarketAreaName(sport.marketArea);
							const sportUrl = marketAreaSlug ? `/communities/${marketAreaSlug}/sports/${sport.slug}` : `/sports/${sport.slug}`;
							return (
								<Item as="a" href={sportUrl}>
									{imageUrl && (
										<ItemMedia variant="image" class="size-20">
											<Image src={imageUrl} alt={sport.title} width={100} height={100} />
										</ItemMedia>
									)}
									<ItemContent>
										<ItemTitle>{sport.title}</ItemTitle>
										<ItemDescription>{sport.description}</ItemDescription>
										{marketAreaName && <ItemDescription class="text-xs italic text-muted-foreground">{marketAreaName}</ItemDescription>}
										<ItemDescription class="text-xs">{formatDate(sport.publishDate)}</ItemDescription>
									</ItemContent>
								</Item>
								<ItemSeparator class="last:hidden" />
							);
						})}
						</ItemGroup>
					) : (
						<p class="text-muted-foreground">No sports articles available.</p>
					)}
				</CardContent>
			</Card>

			<!-- Upcoming Events Section -->
			<Card class="md:col-span-1 lg:col-span-2">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<Icon name="tabler--calendar-pin" class="size-8" />
						Upcoming Events
					</CardTitle>
					<CardDescription>Local community events</CardDescription>
				</CardHeader>
				<CardContent>
					{upcomingEvents.length > 0 ? (
						<ItemGroup>
							{upcomingEvents.map((event) => {
								const imageUrl = getImageFromMedia(event.featuredImage);
								const marketAreaSlug = getMarketAreaSlug(event.marketArea);
								const marketAreaName = getMarketAreaName(event.marketArea);
								const eventUrl = marketAreaSlug ? `/communities/${marketAreaSlug}/events/${event.slug}` : `/events/${event.slug}`;
								return (
									<Item as="a" href={eventUrl}>
										{imageUrl && (
											<ItemMedia variant="image" class="size-20">
												<Image src={imageUrl} alt={event.title} width={100} height={100} />
											</ItemMedia>
										)}
										<ItemContent>
											<ItemTitle>{event.title}</ItemTitle>
											<ItemDescription>{event.description}</ItemDescription>
											{marketAreaName && <ItemDescription class="text-xs italic text-muted-foreground">{marketAreaName}</ItemDescription>}
											<ItemDescription class="text-xs">{formatEventDate(event.eventDate)}</ItemDescription>
										</ItemContent>
									</Item>
									<ItemSeparator class="last:hidden" />
								);
							})}
						</ItemGroup>
					) : (
						<p class="text-muted-foreground">No upcoming events.</p>
					)}
				</CardContent>
			</Card>

			<!-- Blog Posts Section -->
			<Card class="md:col-span-1 lg:col-span-2">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<Icon name="tabler--writing" class="size-8" />
						Latest Blog Posts
					</CardTitle>
					<CardDescription>Stories and insights from our community</CardDescription>
				</CardHeader>
				<CardContent>
					{latestBlogPosts.length > 0 ? (
						<ItemGroup>
							{latestBlogPosts.map((post) => {
								return (
									<Item as="a" href={`/post/${post.slug}`}>
										<ItemContent>
											<ItemTitle>{post.title}</ItemTitle>
											<ItemDescription>{post.description || post.excerpt}</ItemDescription>
											<ItemDescription class="text-xs">{formatDate(post.publishDate || post.publishedAt)}</ItemDescription>
										</ItemContent>
									</Item>
									<ItemSeparator class="last:hidden" />
								);
							})}
						</ItemGroup>
					) : (
						<p class="text-muted-foreground">No blog posts available.</p>
					)}
				</CardContent>
			</Card>

			<Card class="md:col-span-1 lg:col-span-2">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<Icon name="fluent--form-new" class="size-8" />
						Submit Your Content
					</CardTitle>
					<CardDescription>Submit your audio news story or sermon below</CardDescription>
				</CardHeader>
				<CardContent>
					<ItemGroup>
						<Item>
							<ItemContent class="gap-1">
								<ItemTitle>Upload for Schools</ItemTitle>
								<ItemDescription>Submit your audio content here</ItemDescription>
							</ItemContent>
							<ItemActions>
								<Button variant="outline" size="icon" class="rounded-full">
									<Icon name="ArrowRight" class="size-5" />
								</Button>
							</ItemActions>
						</Item>
						<ItemSeparator />
						<Item>
							<ItemContent class="gap-1">
								<ItemTitle>Upload for Churches</ItemTitle>
								<ItemDescription>Submit your sermon audio here</ItemDescription>
							</ItemContent>
							<ItemActions>
								<Button variant="outline" size="icon" class="rounded-full">
									<Icon name="ArrowRight" class="size-5" />
								</Button>
							</ItemActions>
						</Item>
					</ItemGroup>
				</CardContent>
			</Card>
		</div>
	</div>
</BaseLayout>
