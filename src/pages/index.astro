---

import BaseLayout from "@/base/BaseLayout.astro";
import {
	Card,
	CardContent,
	CardDescription,
	CardHeader,
	CardTitle,
} from "@/components/starwind/card";
import { getMediaUrl } from "@/lib/cms-r2-media";
import { type BlogPost, getPayloadClient, type News, type Sports } from "@/payload";

const { env } = Astro.locals.runtime;
const r2BaseUrl = import.meta.env.PUBLIC_R2_URL;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

// Fetch latest news, sports, and blog posts
let latestNews: News[] = [];
let latestSports: Sports[] = [];
let latestBlogPosts: BlogPost[] = [];

try {
	const [newsResult, sportsResult, blogResult] = await Promise.all([
		payload.getNews({ limit: 4, sort: "-publishDate", depth: 1 }),
		payload.getSports({ limit: 4, sort: "-publishDate", depth: 1 }),
		payload.getBlogPosts({ limit: 4, sort: "-publishDate" }),
	]);
	latestNews = newsResult.docs;
	latestSports = sportsResult.docs;
	latestBlogPosts = blogResult.docs;
} catch (e) {
	console.error("Failed to fetch content:", e);
}

// Helper to get image URL from media object
function getImageFromMedia(media: unknown): string | null {
	if (!media || typeof media !== "object") return null;
	const mediaObj = media as { filename?: string };
	if (!mediaObj.filename) return null;
	return getMediaUrl(mediaObj as Parameters<typeof getMediaUrl>[0], r2BaseUrl);
}

// Helper to format date
function formatDate(dateString: string | undefined): string {
	if (!dateString) return "";
	return new Date(dateString).toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<BaseLayout>
	<div class="w-full mx-auto px-4 py-8">
		<h1 class="mb-8 text-3xl font-bold text-foreground">Welcome to TSFTI Radio</h1>
		
		<!-- CSS Grid Layout -->
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			<!-- Latest News Section -->
			<Card class="md:col-span-1 lg:col-span-2">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
						</svg>
						Latest News
					</CardTitle>
					<CardDescription>Stay updated with the latest news</CardDescription>
				</CardHeader>
				<CardContent>
					{latestNews.length > 0 ? (
						<ul class="space-y-4">
							{latestNews.map((news) => {
								const imageUrl = getImageFromMedia(news.featuredImage);
								return (
									<li class="group flex gap-4 border-b border-border pb-4 last:border-0 last:pb-0">
										{imageUrl && (
											<img
												src={imageUrl}
												alt={news.title}
												class="h-20 w-20 flex-shrink-0 rounded-lg object-cover"
											/>
										)}
										<div class="flex-1">
											<a href={`/news/${news.slug}`} class="font-semibold text-foreground hover:text-primary transition-colors">
												{news.title}
											</a>
											<p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{news.description}</p>
											<span class="mt-1 text-xs text-muted-foreground">{formatDate(news.publishDate)}</span>
										</div>
									</li>
								);
							})}
						</ul>
					) : (
						<p class="text-muted-foreground">No news articles available.</p>
					)}
				</CardContent>
			</Card>

			<!-- Sports Section -->
			<Card>
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						Sports
					</CardTitle>
					<CardDescription>Local sports coverage</CardDescription>
				</CardHeader>
				<CardContent>
					{latestSports.length > 0 ? (
						<ul class="space-y-4">
							{latestSports.map((sport) => {
								const imageUrl = getImageFromMedia(sport.featuredImage);
								return (
									<li class="group flex gap-4 border-b border-border pb-4 last:border-0 last:pb-0">
										{imageUrl && (
											<img
												src={imageUrl}
												alt={sport.title}
												class="h-20 w-20 flex-shrink-0 rounded-lg object-cover"
											/>
										)}
										<div class="flex-1">
											<a href={`/sports/${sport.slug}`} class="font-semibold text-foreground hover:text-primary transition-colors">
												{sport.title}
											</a>
											<p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{sport.description}</p>
											<span class="mt-1 text-xs text-muted-foreground">{formatDate(sport.publishDate)}</span>
										</div>
									</li>
								);
							})}
						</ul>
					) : (
						<p class="text-muted-foreground">No sports articles available.</p>
					)}
				</CardContent>
			</Card>

			<!-- Blog Posts Section -->
			<Card class="md:col-span-2 lg:col-span-1">
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
						</svg>
						Latest Blog Posts
					</CardTitle>
					<CardDescription>Stories and insights from our community</CardDescription>
				</CardHeader>
				<CardContent>
					{latestBlogPosts.length > 0 ? (
						<ul class="space-y-4">
							{latestBlogPosts.map((post) => {
								const featuredImage = (post as { featuredImage?: { filename?: string } }).featuredImage;
								const imageUrl = getImageFromMedia(featuredImage);
								return (
									<li class="group flex gap-4 border-b border-border pb-4 last:border-0 last:pb-0">
										{imageUrl && (
											<img
												src={imageUrl}
												alt={post.title}
												class="h-20 w-20 flex-shrink-0 rounded-lg object-cover"
											/>
										)}
										<div class="flex-1">
											<a href={`/post/${post.slug}`} class="font-semibold text-foreground hover:text-primary transition-colors">
												{post.title}
											</a>
											<p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{post.description || post.excerpt}</p>
											<span class="mt-1 text-xs text-muted-foreground">{formatDate(post.publishDate || post.publishedAt)}</span>
										</div>
									</li>
								);
							})}
						</ul>
					) : (
						<p class="text-muted-foreground">No blog posts available.</p>
					)}
				</CardContent>
			</Card>

			<!-- Placeholder Section 1 -->
			<Card>
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
						</svg>
						Coming Soon
					</CardTitle>
					<CardDescription>More content on the way</CardDescription>
				</CardHeader>
				<CardContent>
					<div class="flex h-32 items-center justify-center rounded-lg border-2 border-dashed border-muted-foreground/25">
						<p class="text-muted-foreground">Additional content coming soon</p>
					</div>
				</CardContent>
			</Card>

			<!-- Placeholder Section 2 -->
			<Card>
				<CardHeader>
					<CardTitle class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
						Featured
					</CardTitle>
					<CardDescription>Featured content area</CardDescription>
				</CardHeader>
				<CardContent>
					<div class="flex h-32 items-center justify-center rounded-lg border-2 border-dashed border-muted-foreground/25">
						<p class="text-muted-foreground">Featured content coming soon</p>
					</div>
				</CardContent>
			</Card>
		</div>
	</div>
</BaseLayout>
