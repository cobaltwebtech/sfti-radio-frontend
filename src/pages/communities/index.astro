---
import { env } from "cloudflare:workers";
import BaseLayout from "@/base/BaseLayout.astro";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import {
	Card,
	CardContent,
	CardDescription,
	CardFooter,
	CardHeader,
	CardTitle,
} from "@/components/starwind/card";
import { siteMeta } from "@/lib/siteData";
import { getPayloadClient, type MarketArea } from "@/payload";

const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

// Fetch market areas from the "market-areas" collection
let marketAreas: MarketArea[] = [];
let error: string | null = null;

try {
	const result = await payload.getMarketAreas({
		limit: 50,
		sort: "name",
	});
	marketAreas = result.docs;
} catch (e) {
	console.error("Failed to fetch market areas:", e);
	error = e instanceof Error ? e.message : "Failed to fetch market areas";
}
const pageTitle: string = `Communities | ${siteMeta.title}`;
---

<BaseLayout title={pageTitle}>
		<h1>Communities</h1>

		{error && (
			<div>
				<p>Error loading communities: {error}</p>
			</div>
		)}

		{marketAreas.length === 0 && !error && (
			<p class="text-desctructive">No communities found.</p>
		)}

		{marketAreas.length > 0 && (
			<ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
				{marketAreas.map((community) => (
					//biome-ignore lint/correctness/useJsxKeyInIterable: Ignore since this is JSX in Astro which does not require a key
					<li>
						<a class="group" href={`/communities/${community.slug}`}>
						<Card class="h-full flex flex-col justify-between">
							<CardHeader>
								<CardTitle>{community.name}</CardTitle>
								{community.description && 
									<CardDescription class="description">
										{community.description}
									</CardDescription>
								}
								</CardHeader>
								{community.surroundingAreas && community.surroundingAreas.length > 0 && (
									<CardContent>
										<p class="mb-2 text-xs">Surrounding Communities</p>
										<div class="flex flex-wrap gap-2">
											{community.surroundingAreas.map((adjacentTown) => (
												//biome-ignore lint/correctness/useJsxKeyInIterable: Ignore since this is JSX in Astro which does not require a key
												<Badge variant="outline" class="font-light">{adjacentTown.name}</Badge>
											))}
										</div>
									</CardContent>
								)}
								<CardFooter class="justify-end">
									<Button 
										variant="info" 
										size="sm"
										class="group-hover:bg-info/90"
									>View Community Page &rarr;</Button>
								</CardFooter>
						</Card>
						</a>
					</li>
				))}
			</ul>
		)}
</BaseLayout>
