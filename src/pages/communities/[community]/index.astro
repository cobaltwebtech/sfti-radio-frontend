---



import { env } from "cloudflare:workers";
import BaseLayout from "@/base/BaseLayout.astro";
import { Badge } from "@/components/starwind/badge";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import { Button } from "@/components/starwind/button";
import {
	Card,
	CardContent,
	CardDescription,
	CardFooter,
	CardHeader,
	CardTitle,
} from "@/components/starwind/card";
import ListenButton from "@/components/streaming-player/ListenButton";
import Church from "@/icons/church.svg";
import FacebookCircle from "@/icons/FacebookCircle.svg";
import Football from "@/icons/football.svg";
import CalendarClock from "@/icons/lucide--calendar-clock.svg";
import Megaphone from "@/icons/megaphone.svg";
import Newspaper from "@/icons/newspaper.svg";
import Party from "@/icons/party.svg";
import Sun from "@/icons/Sun.svg";
import School from "@/icons/school.svg";
import CalendarPin from "@/icons/tabler--calendar-pin.svg";
import { siteMeta } from "@/lib/siteData";
import { getPayloadClient, type MarketArea } from "@/payload";

const { community } = Astro.params;

const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

// Fetch the market area by slug
let marketArea: MarketArea | null = null;
let error: string | null = null;

try {
	marketArea = await payload.getMarketAreaBySlug(community as string);

	if (!marketArea) {
		return Astro.redirect("/404");
	}
} catch (e) {
	console.error("Failed to fetch market area:", e);
	error = e instanceof Error ? e.message : "Failed to fetch market area";
}

const pageTitle = marketArea
	? `${marketArea.name} | ${siteMeta.title}`
	: `Community | ${siteMeta.title}`;

// Parse program schedule plain text into structured entries
const scheduleEntries = marketArea?.programSchedule
	? marketArea.programSchedule
		.split("\n")
		.filter((line) => line.trim())
		.map((line) => {
			const match = line.match(/^(\d{1,2}(?::\d{2})?\s*(?:AM|PM|am|pm)?)\s+(.+)$/);
			return match ? { time: match[1], program: match[2] } : null;
		})
		.filter(Boolean) as { time: string; program: string }[]
	: [];

// Fetch content counts to conditionally render navigation cards
const [newsData, sportsData, eventsData, churchesData, schoolsData] =
	await Promise.all([
		payload.getNewsByMarketAreaSlug(community as string, { limit: 1 }),
		payload.getSportsByMarketAreaSlug(community as string, { limit: 1 }),
		payload.getLocalEventsByMarketAreaSlug(community as string, {
			limit: 1,
			upcomingOnly: true,
		}),
		payload.getChurchesByMarketAreaSlug(community as string, { limit: 1 }),
		payload.getSchoolsByMarketAreaSlug(community as string, { limit: 1 }),
	]);

const communityNavLinks = [
	{
		title: "News",
		url: `/communities/${community}/news`,
		icon: Newspaper,
		description: "Latest news stories and happenings in the community.",
		hasContent: newsData.totalDocs > 0,
	},
	{
		title: "Sports",
		url: `/communities/${community}/sports`,
		icon: Football,
		description: "Local sports coverage, scores, and team updates.",
		hasContent: sportsData.totalDocs > 0,
	},
	{
		title: "Events",
		url: `/communities/${community}/events`,
		icon: Party,
		description: "Upcoming local events and activities.",
		hasContent: eventsData.totalDocs > 0,
	},
	{
		title: "Churches",
		url: `/communities/${community}/churches`,
		icon: Church,
		description: "Local churches and places of worship.",
		hasContent: churchesData.totalDocs > 0,
	},
	{
		title: "Schools",
		url: `/communities/${community}/schools`,
		icon: School,
		description: "Schools and educational institutions in the area.",
		hasContent: schoolsData.totalDocs > 0,
	},
].filter((link) => link.hasContent);
---

<BaseLayout title={pageTitle}>
	{error && (
		<div class="bg-error/10 border border-error text-error-foreground p-4 rounded-lg mb-6">
			<p>Error loading community: {error}</p>
		</div>
	)}

	{marketArea && (
		<>
			<section class="w-full space-y-6">
				<Breadcrumb class="mb-6">
					<BreadcrumbList>
						<BreadcrumbItem>
							<BreadcrumbLink href="/">Home</BreadcrumbLink>
						</BreadcrumbItem>
						<BreadcrumbSeparator />
						<BreadcrumbItem>
							<BreadcrumbLink href="/communities">Communities</BreadcrumbLink>
						</BreadcrumbItem>
						<BreadcrumbSeparator />
						<BreadcrumbItem>
							<BreadcrumbPage>{marketArea.name}</BreadcrumbPage>
						</BreadcrumbItem>
					</BreadcrumbList>
				</Breadcrumb>

					<h1 class="text-center">{marketArea.name}</h1>
					{marketArea.description && (
						<p class="text-lg text-muted-foreground text-center">{marketArea.description}</p>
					)}

				{/* Live Radio Streams */}
				{(marketArea.streamIds?.length || marketArea.customStreamUrl?.length) ? (
					<>
						<p class="text-center font-semibold">Select a station to start listening</p>
						<div class="flex flex-wrap justify-center gap-3">
							{/* Live365 Streams */}
							{marketArea.streamIds?.map((stream) => (
								//biome-ignore lint/correctness/useJsxKeyInIterable: Ignore since this is JSX in Astro which does not require a key								
								<ListenButton 
									client:visible
									stream={{ id: stream.streamId, title: stream.title }} 
									className="text-lg font-semibold py-7"
									size="lg"
									variant="success"
								/>
							))}
							{/* Custom URL Streams */}
							{marketArea.customStreamUrl?.map((stream) => (
								//biome-ignore lint/correctness/useJsxKeyInIterable: Ignore since this is JSX in Astro which does not require a key
								<ListenButton 
									client:visible
									stream={{ id: stream.id ?? stream.url, title: stream.title, url: stream.url }}
									className="text-lg font-semibold py-7"
									size="lg"
								/>
							))}
						</div>
					</>
				) : null}

				{/* Facebook Page Link */}
				{marketArea.facebookUrl && (
					<div class="text-center space-y-1">
						<p>Follow us on Facebook</p>
						<Button
							href={marketArea.facebookUrl}
							target="_blank"
							rel="noopener noreferrer"
							size="icon"
						>
							<FacebookCircle class="size-8" />
						</Button>
					</div>
				)}

				{/* Program Schedule */}
				<div class="w-full p-6 rounded-2xl border bg-muted">
					<h2 class="flex items-center gap-2 mb-4">
						<CalendarClock class="size-8" />
						Program Schedule
					</h2>
					<div class="grid sm:grid-cols-2 gap-4">
						<Card>
							<CardHeader>
								<CardTitle>Ongoing Broadcasts</CardTitle>
							</CardHeader>
							<CardContent class="space-y-4">
								<div class="flex items-center gap-2">
									<Megaphone class="size-8 text-secondary"/>
									<div>
										<p class="font-semibold">Local News</p>
										<p class="text-sm text-muted-foreground font-light">24/7 coverage at the top of the hour</p>
									</div>
								</div>
								<div class="flex items-center gap-2">
									<Sun class="size-8 text-secondary"/>
									<div>
										<p class="font-semibold">Local Weather</p>
										<p class="text-sm text-muted-foreground font-light">24/7 updates throughout the day</p>
									</div>
								</div>
								<div class="flex items-center gap-2">
									<CalendarPin class="size-8 text-secondary"/>
									<div>
										<p class="font-semibold">Local Events</p>
										<p class="text-sm text-muted-foreground font-light">24/7 events at the bottom of the hour</p>
									</div>
								</div>
							</CardContent>
						</Card>
							<Card>
								<CardHeader>
									<CardTitle>Daily Schedule</CardTitle>
								</CardHeader>
								<CardContent>
									{scheduleEntries.length > 0 ? (
										<ul class="space-y-4">
											{scheduleEntries.map((entry) => (
											//biome-ignore lint/correctness/useJsxKeyInIterable: Ignore since this is JSX in Astro which does not require a key
												<li class="flex items-baseline justify-between gap-2 pb-2 border-b last:border-0">
													<span class="font-bold text-sm text-muted-foreground">{entry.time}</span>
													<span class="text-sm text-right">{entry.program}</span>
												</li>
											))}
										</ul>
									) : (
										<p class="text-muted-foreground">Schedule coming soon for this community.</p>
									)}
								</CardContent>
							</Card>
					</div>
				</div>
			</section>

			<section>
				{marketArea.surroundingAreas && marketArea.surroundingAreas.length > 0 && (
					<div class="mb-8 space-y-2">
						<h2>Surrounding Areas</h2>
						<ul class="flex flex-wrap gap-2">
							{marketArea.surroundingAreas.map((adjacentTown) => (
								//biome-ignore lint/correctness/useJsxKeyInIterable: Ignore since this is JSX in Astro which does not require a key
								<li><Badge variant="outline">{adjacentTown.name}</Badge></li>
							))}
						</ul>
					</div>
				)}

				{/* Navigation to community sections */}
				{communityNavLinks.length > 0 && (
				<nav class="mt-12 space-y-4">
					<h3>Explore {marketArea.name}</h3>
					<ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
						{communityNavLinks.map((link) => {
						const NavIcon = link.icon;
						return (
							//biome-ignore lint/correctness/useJsxKeyInIterable: Ignore since this is JSX in Astro which does not require a key
							<li>
								<Card class="h-full flex flex-col justify-between items-center">
									<CardHeader class="text-center">
										<CardTitle>{link.title}</CardTitle>
										<CardDescription>{link.description}</CardDescription>
									</CardHeader>
									<CardContent>
										<NavIcon class="size-20"/>
									</CardContent>
									<CardFooter>
										<Button href={link.url}>View {link.title} &rarr;</Button>
									</CardFooter>
								</Card>
							</li>
						);
					})}
					</ul>
				</nav>
				)}
			</section>
		</>
	)}
</BaseLayout>
