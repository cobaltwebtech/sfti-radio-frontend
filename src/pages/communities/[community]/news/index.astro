---
import BaseLayout from "@/base/BaseLayout.astro";
import { siteMeta } from "@/lib/siteData";
import { getPayloadClient, type MarketArea, type News } from "@/payload";

const { community } = Astro.params;

const { env } = Astro.locals.runtime;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

// Fetch market area and news in parallel
let marketArea: MarketArea | null = null;
let news: News[] = [];
let error: string | null = null;

try {
	const [marketAreaResult, newsResult] = await Promise.all([
		payload.getMarketAreaBySlug(community as string),
		payload.getNewsByMarketAreaSlug(community as string, {
			limit: 20,
			depth: 1,
		}),
	]);

	marketArea = marketAreaResult;
	news = newsResult.docs;

	if (!marketArea) {
		return Astro.redirect("/404");
	}
} catch (e) {
	console.error("Failed to fetch news:", e);
	error = e instanceof Error ? e.message : "Failed to fetch news";
}

const pageTitle = marketArea
	? `News | ${marketArea.name} | ${siteMeta.title}`
	: `News | ${siteMeta.title}`;
---

<BaseLayout title={pageTitle}>
	<div class="max-w-4xl mx-auto px-4 py-8">
		{/* Breadcrumb */}
		{marketArea && (
			<nav class="mb-6 text-sm">
				<a href="/communities" class="hover:underline">Communities</a>
				<span class="mx-2">/</span>
				<a href={`/communities/${community}`} class="hover:underline">{marketArea.name}</a>
				<span class="mx-2">/</span>
				<span class="text-muted-foreground">News</span>
			</nav>
		)}

		<header class="mb-8">
			<h1 class="mb-2">News</h1>
			{marketArea && (
				<p class="text-lg text-muted-foreground">Latest news from {marketArea.name}</p>
			)}
		</header>

		{error && (
			<div class="bg-error/10 border border-error text-error-foreground p-4 rounded-lg mb-6">
				<p>Error loading news: {error}</p>
			</div>
		)}

		{news.length === 0 && !error && (
			<p class="text-muted-foreground">No news articles found for this community.</p>
		)}

		{news.length > 0 && (
			<div class="space-y-8">
				{news.map((article) => (
					<article class="bg-card rounded-lg p-6">
						<header class="mb-4">
							<h2 class="text-2xl mb-2">
								<a href={`/communities/${community}/news/${article.slug}`}>
									{article.title}
								</a>
							</h2>
							<p class="text-sm text-muted-foreground">
								{new Date(article.publishDate).toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</p>
						</header>
						<p class="text-muted-foreground">{article.description}</p>
						<a 
							href={`/communities/${community}/news/${article.slug}`}
							class="inline-block mt-4 text-sm font-medium"
						>
							Read more →
						</a>
					</article>
				))}
			</div>
		)}
	</div>
</BaseLayout>
