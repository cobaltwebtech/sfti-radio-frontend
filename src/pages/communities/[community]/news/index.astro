---
import { env } from "cloudflare:workers";
import BaseLayout from "@/base/BaseLayout.astro";
import type { CommunityItem } from "@/components/pagination";
import PaginatedListWrapper from "@/components/pagination/PaginatedListWrapper.astro";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import { siteMeta } from "@/lib/siteData";
import { getPayloadClient, type MarketArea } from "@/payload";

const { community } = Astro.params;
const url = new URL(Astro.request.url);
const limit = Math.min(
	Math.max(parseInt(url.searchParams.get("limit") || "20", 10), 1),
	100,
);

const r2BaseUrl = import.meta.env.PUBLIC_R2_URL;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

let marketArea: MarketArea | null = null;
let news: CommunityItem[] = [];
let hasNextPage = false;
let error: string | null = null;

try {
	const [marketAreaResult, newsResult] = await Promise.all([
		payload.getMarketAreaBySlug(community as string),
		payload.getNewsByMarketAreaSlug(community as string, {
			limit,
			depth: 1,
		}),
	]);

	marketArea = marketAreaResult;
	news = newsResult.docs;
	hasNextPage = newsResult.hasNextPage;

	if (!marketArea) {
		return Astro.redirect("/404");
	}
} catch (e) {
	console.error("Failed to fetch news:", e);
	error = e instanceof Error ? e.message : "Failed to fetch news";
}

const pageTitle = marketArea
	? `News | ${marketArea.name} | ${siteMeta.title}`
	: `News | ${siteMeta.title}`;
---

<BaseLayout title={pageTitle}>
	<section class="mb-8">
		{marketArea && (
			<Breadcrumb class="mb-6">
				<BreadcrumbList>
					<BreadcrumbItem>
						<BreadcrumbLink href="/">Home</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbLink href="/communities">Communities</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbLink href={`/communities/${community}`}>{marketArea.name}</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbPage>News</BreadcrumbPage>
					</BreadcrumbItem>
				</BreadcrumbList>
			</Breadcrumb>
		)}

		<h1 class="mb-2 text-center">News</h1>
		{marketArea && (
			<p class="text-lg text-muted-foreground text-center">Latest news from {marketArea.name}</p>
		)}
	</section>

	<section>
		{error && (
			<div class="bg-error/10 border border-error text-error-foreground p-4 rounded-lg mb-6">
				<p>Error loading news: {error}</p>
			</div>
		)}

		{news.length === 0 && !error && (
			<p class="text-muted-foreground">No news articles found for this community.</p>
		)}

		{news.length > 0 && (
			<PaginatedListWrapper
				items={news}
				community={community as string}
				collection="news"
				hasNextPage={hasNextPage}
				limit={limit}
				r2BaseUrl={r2BaseUrl}
			/>
		)}
	</section>
</BaseLayout>
