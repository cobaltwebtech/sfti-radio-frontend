---
import { Image } from "astro:assets";
import BaseLayout from "@/base/BaseLayout.astro";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import { getMediaUrl, isMediaObject } from "@/lib/cms-r2-media";
import {
	type LexicalContent,
	renderLexicalToHtml,
} from "@/lib/lexical-renderer";
import { siteMeta } from "@/lib/siteData";
import { getPayloadClient, type MarketArea, type School } from "@/payload";

const { community, slug } = Astro.params;

const { env } = Astro.locals.runtime;
const r2BaseUrl = import.meta.env.PUBLIC_R2_URL;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

let marketArea: MarketArea | null = null;
let school: School | null = null;
let error: string | null = null;

try {
	const [marketAreaResult, schoolResult] = await Promise.all([
		payload.getMarketAreaBySlug(community as string),
		payload.getSchoolBySlug(slug as string, { depth: 1 }),
	]);

	marketArea = marketAreaResult;
	school = schoolResult;

	if (!marketArea || !school) {
		return Astro.redirect("/404");
	}
} catch (e) {
	console.error("Failed to fetch school:", e);
	error = e instanceof Error ? e.message : "Failed to fetch school";
}

const pageTitle = school
	? `${school.name} | Schools | ${marketArea?.name} | ${siteMeta.title}`
	: `Schools | ${siteMeta.title}`;

const contentHtml = school?.content
	? renderLexicalToHtml(school.content as unknown as LexicalContent, r2BaseUrl)
	: "";
---

<BaseLayout title={pageTitle}>
	<article class="max-w-4xl mx-auto px-4 py-8">
		{/* Breadcrumb */}
		{marketArea && (
			<Breadcrumb class="mb-6">
				<BreadcrumbList>
					<BreadcrumbItem>
						<BreadcrumbLink href="/">Home</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbLink href="/communities">Communities</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbLink href={`/communities/${community}`}>{marketArea.name}</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbLink href={`/communities/${community}/schools`}>Schools</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbPage>{school?.name}</BreadcrumbPage>
					</BreadcrumbItem>
				</BreadcrumbList>
			</Breadcrumb>
		)}

		{error && (
			<div class="bg-error/10 border border-error text-error-foreground p-4 rounded-lg mb-6">
				<p>Error loading school: {error}</p>
			</div>
		)}

		{school && (
			<>
				{/* Featured Image */}
				{isMediaObject(school.featuredImage) && getMediaUrl(school.featuredImage, r2BaseUrl) && (
					<div class="max-w-1/2 mx-auto mb-8 rounded-lg overflow-hidden">
						<Image
							src={getMediaUrl(school.featuredImage, r2BaseUrl)!}
							alt={school.featuredImage.alt || school.name}
							width={school.featuredImage.width || 1200}
							height={school.featuredImage.height || 630}
							class="w-full h-auto object-cover"
						/>
					</div>
				)}

				<header class="mb-8 text-center">
					<h1 class="mb-2">{school.name}</h1>
					{school.description && (
						<p class="text-lg text-muted-foreground">{school.description}</p>
					)}
				</header>

				{/* School info cards */}
				<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mb-8">
					{/* Basic info */}
					{(school.district || school.grades) && (
						<div class="bg-card rounded-lg p-4">
							<h2 class="text-lg font-semibold mb-3">School Info</h2>
							{school.district && (
								<p class="mb-2">
									<span class="text-muted-foreground">District:</span> {school.district}
								</p>
							)}
							{school.grades && (
								<p>
									<span class="text-muted-foreground">Grades:</span> {school.grades}
								</p>
							)}
						</div>
					)}

					{/* Contact info */}
					{school.contact && (school.contact.phone || school.contact.email || school.contact.website) && (
						<div class="bg-card rounded-lg p-4">
							<h2 class="text-lg font-semibold mb-3">Contact</h2>
							{school.contact.phone && (
								<p class="mb-2">
									<span class="text-muted-foreground">Phone:</span>{" "}
									<a href={`tel:${school.contact.phone}`}>{school.contact.phone}</a>
								</p>
							)}
							{school.contact.email && (
								<p class="mb-2">
									<span class="text-muted-foreground">Email:</span>{" "}
									<a href={`mailto:${school.contact.email}`}>{school.contact.email}</a>
								</p>
							)}
							{school.contact.website && (
								<p>
									<span class="text-muted-foreground">Website:</span>{" "}
									<a href={school.contact.website} target="_blank" rel="noopener noreferrer">
										Visit website
									</a>
								</p>
							)}
						</div>
					)}

					{/* Location */}
					{school.location?.address && (
						<div class="bg-card rounded-lg p-4">
							<h2 class="text-lg font-semibold mb-3">Location</h2>
							<p>{school.location.address}</p>
						</div>
					)}
				</div>

				{/* Content */}
				{contentHtml && (
					<div class="prose prose-lg max-w-none dark:prose-invert" set:html={contentHtml} />
				)}
			</>
		)}
	</article>
</BaseLayout>
