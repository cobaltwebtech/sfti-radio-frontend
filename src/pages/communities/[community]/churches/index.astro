---
import { env } from "cloudflare:workers";
import BaseLayout from "@/base/BaseLayout.astro";
import type { PlaceItem } from "@/components/pagination";
import PlacesListWrapper from "@/components/pagination/PlacesListWrapper.astro";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import { siteMeta } from "@/lib/siteData";
import { getPayloadClient, type MarketArea } from "@/payload";

const { community } = Astro.params;
const url = new URL(Astro.request.url);
const limit = Math.min(
	Math.max(parseInt(url.searchParams.get("limit") || "20", 10), 1),
	100,
);

const r2BaseUrl = import.meta.env.PUBLIC_R2_URL;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

let marketArea: MarketArea | null = null;
let churches: PlaceItem[] = [];
let hasNextPage = false;
let error: string | null = null;

try {
	const [marketAreaResult, churchesResult] = await Promise.all([
		payload.getMarketAreaBySlug(community as string),
		payload.getChurchesByMarketAreaSlug(community as string, {
			limit,
			depth: 1,
		}),
	]);

	marketArea = marketAreaResult;
	churches = churchesResult.docs;
	hasNextPage = churchesResult.hasNextPage;

	if (!marketArea) {
		return Astro.redirect("/404");
	}
} catch (e) {
	console.error("Failed to fetch churches:", e);
	error = e instanceof Error ? e.message : "Failed to fetch churches";
}

const pageTitle = marketArea
	? `Churches | ${marketArea.name} | ${siteMeta.title}`
	: `Churches | ${siteMeta.title}`;
---

<BaseLayout title={pageTitle}>
	<section class="mb-8">
		{marketArea && (
			<Breadcrumb class="mb-6">
				<BreadcrumbList>
					<BreadcrumbItem>
						<BreadcrumbLink href="/">Home</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbLink href="/communities">Communities</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbLink href={`/communities/${community}`}>{marketArea.name}</BreadcrumbLink>
					</BreadcrumbItem>
					<BreadcrumbSeparator />
					<BreadcrumbItem>
						<BreadcrumbPage>Churches</BreadcrumbPage>
					</BreadcrumbItem>
				</BreadcrumbList>
			</Breadcrumb>
		)}

		<h1 class="mb-2 text-center">Churches</h1>
		{marketArea && (
			<p class="text-lg text-muted-foreground text-center">Churches in {marketArea.name}</p>
		)}
	</section>

	<section>
		{error && (
			<div class="bg-error/10 border border-error text-error-foreground p-4 rounded-lg mb-6">
				<p>Error loading churches: {error}</p>
			</div>
		)}

		{churches.length === 0 && !error && (
			<p class="text-muted-foreground">No churches found for this community.</p>
		)}

		{churches.length > 0 && (
			<PlacesListWrapper
				items={churches}
				community={community as string}
				collection="churches"
				hasNextPage={hasNextPage}
				limit={limit}
				r2BaseUrl={r2BaseUrl}
			/>
		)}
	</section>
</BaseLayout>
