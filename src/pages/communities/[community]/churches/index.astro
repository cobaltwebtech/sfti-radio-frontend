---

import BaseLayout from "@/base/BaseLayout.astro";
import { siteMeta } from "@/lib/siteData";
import { type Church, getPayloadClient, type MarketArea } from "@/payload";

const { community } = Astro.params;

const { env } = Astro.locals.runtime;
const payload = getPayloadClient({
	worker: env.PAYLOAD_CMS_WORKER,
	apiUrl: env.PAYLOAD_API_URL,
});

let marketArea: MarketArea | null = null;
let churches: Church[] = [];
let error: string | null = null;

try {
	const [marketAreaResult, churchesResult] = await Promise.all([
		payload.getMarketAreaBySlug(community as string),
		payload.getChurchesByMarketAreaSlug(community as string, {
			limit: 50,
			depth: 1,
		}),
	]);

	marketArea = marketAreaResult;
	churches = churchesResult.docs;

	if (!marketArea) {
		return Astro.redirect("/404");
	}
} catch (e) {
	console.error("Failed to fetch churches:", e);
	error = e instanceof Error ? e.message : "Failed to fetch churches";
}

const pageTitle = marketArea
	? `Churches | ${marketArea.name} | ${siteMeta.title}`
	: `Churches | ${siteMeta.title}`;
---

<BaseLayout title={pageTitle}>
	<div class="max-w-4xl mx-auto px-4 py-8">
		{/* Breadcrumb */}
		{marketArea && (
			<nav class="mb-6 text-sm">
				<a href="/communities" class="hover:underline">Communities</a>
				<span class="mx-2">/</span>
				<a href={`/communities/${community}`} class="hover:underline">{marketArea.name}</a>
				<span class="mx-2">/</span>
				<span class="text-muted-foreground">Churches</span>
			</nav>
		)}

		<header class="mb-8">
			<h1 class="mb-2">Churches</h1>
			{marketArea && (
				<p class="text-lg text-muted-foreground">Churches in {marketArea.name}</p>
			)}
		</header>

		{error && (
			<div class="bg-error/10 border border-error text-error-foreground p-4 rounded-lg mb-6">
				<p>Error loading churches: {error}</p>
			</div>
		)}

		{churches.length === 0 && !error && (
			<p class="text-muted-foreground">No churches found for this community.</p>
		)}

		{churches.length > 0 && (
			<div class="grid gap-6 md:grid-cols-2">
				{churches.map((church) => (
					<article class="bg-card rounded-lg p-6">
						<header class="mb-3">
							<h2 class="text-xl mb-1">
								<a href={`/communities/${community}/churches/${church.slug}`}>
									{church.name}
								</a>
							</h2>
							{church.denomination && (
								<p class="text-sm text-muted-foreground">{church.denomination}</p>
							)}
						</header>
						
						{church.location?.address && (
							<p class="text-sm text-muted-foreground mb-2">
								📍 {church.location.address}
							</p>
						)}
						
						{church.contact?.phone && (
							<p class="text-sm text-muted-foreground">
								📞 {church.contact.phone}
							</p>
						)}
						
						<a 
							href={`/communities/${community}/churches/${church.slug}`}
							class="inline-block mt-4 text-sm font-medium"
						>
							View details →
						</a>
					</article>
				))}
			</div>
		)}
	</div>
</BaseLayout>
