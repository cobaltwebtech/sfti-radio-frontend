---

import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { tv } from "tailwind-variants";

import PaginationLink from "./PaginationLink.astro";

type Props = HTMLAttributes<"a"> & { size?: "sm" | "md" | "lg" | "icon" };

export const paginationPrevious = tv({ base: "group gap-1" });

const { class: className, size = "sm", ...rest } = Astro.props;
---

<PaginationLink
  aria-label="Go to previous page"
  size={size}
  class={paginationPrevious({ class: className })}
  data-slot="pagination-previous"
  {...rest}
>
  <slot name="icon">
    <Icon name="ChevronLeft" class="size-5 transition-transform group-hover:-translate-x-1" />
    Prev
  </slot>
  <slot />
</PaginationLink>
