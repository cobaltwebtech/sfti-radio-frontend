---

import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { tv } from "tailwind-variants";

import PaginationLink from "./PaginationLink.astro";

type Props = HTMLAttributes<"a"> & { size?: "sm" | "md" | "lg" | "icon" };

export const paginationNext = tv({ base: "group gap-1" });

const { class: className, size = "sm", ...rest } = Astro.props;
---

<PaginationLink
  aria-label="Go to next page"
  size={size}
  class={paginationNext({ class: className })}
  data-slot="pagination-next"
  {...rest}
>
  <slot />
  <slot name="icon">
    Next
    <Icon name="ChevronRight" class="size-5 transition-transform group-hover:translate-x-1" />
  </slot>
</PaginationLink>
