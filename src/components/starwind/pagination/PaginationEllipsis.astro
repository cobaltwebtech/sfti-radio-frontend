---

import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";
import Ellipsis from "@/icons/Ellipsis.svg";

type Props = HTMLAttributes<"span">;

export const paginationEllipsis = tv({
	base: "flex size-8 items-center justify-center",
});

const { class: className, ...rest } = Astro.props;
---

<span
  aria-hidden
  class={paginationEllipsis({ class: className })}
  data-slot="pagination-ellipsis"
  {...rest}
>
  <slot name="icon">
    <Ellipsis class="size-6"/>
  </slot>
  <slot>
    <span class="sr-only">More pages</span>
  </slot>
</span>
