---

import { Icon } from "astro-icon/components";
import { Button } from "@/components/starwind/button";
---

<section class="mx-auto max-w-lg space-y-4 py-8 text-center">
  <p class="text-warning text-xl font-semibold">
    We need your help to continue our mission!
  </p>
  <div class="flex flex-wrap justify-center gap-4">
    <Button href="/donate" variant="warning">
      <Icon name="DollarSignCircle" class="size-6" />Donate Now
    </Button>
    <Button variant="secondary" href="/membership">
      <Icon name="HeartHandshake" class="size-6" />Become a Member
    </Button>
  </div>
  <p class="text-sm">
    Help us continue our mission by donating now. Your charitable contributions
    directly aid in our work and are completely tax deductible.
  </p>
</section>
